# Server configuration
PORT=3000

# Server secret for token hashing (minimum 32 characters)
# Generate with: openssl rand -hex 32
SERVER_SECRET=your-server-secret-here-minimum-32-characters

# DynDNS authentication
# Store the HASHED token here (hash your plain token with the SERVER_SECRET)
# To generate: npm run generate-token"
DYNDNS_TOKEN=your-hashed-token-here
DYNDNS_USERNAME=your-username-here

# Hetzner DNS API configuration
HETZNER_API_TOKEN=your-hetzner-api-token-here
HETZNER_ZONE_ID=your-zone-id-here
HETZNER_ARECORD_NAME=your-subdomain-here
